(vl-load-com)
(load "C:/Users/User/Documents/Codex/2026-07-20/new-chat-2/work/BatchPlotPlus/Bundle/BatchPlotPlus.bundle/Contents/BatchPlotPlus.lsp")
(princ (strcat "\nBPP_STEP_1_ROOT=" (vl-princ-to-string *bpp:root*)))
(setq bpp_test_path (bpp:content-path "BatchPlotPlus.dcl"))
(princ (strcat "\nBPP_STEP_2_PATH=" (vl-princ-to-string bpp_test_path)))
(setq bpp_test_id (load_dialog bpp_test_path))
(princ (strcat "\nBPP_STEP_3_DCLID=" (vl-princ-to-string bpp_test_id)))
(setq bpp_test_new (new_dialog "batchplotplus" bpp_test_id))
(princ (strcat "\nBPP_STEP_4_NEW=" (vl-princ-to-string bpp_test_new)))
(setq bpp_test_values (bpp:ui-values))
(princ (strcat "\nBPP_STEP_5_VALUES=" (vl-princ-to-string bpp_test_values)))
(set_tile "frame_name" (car bpp_test_values))
(set_tile "frame_count" (cadr bpp_test_values))
(set_tile "range_status" (caddr bpp_test_values))
(start_list "paper")
(mapcar 'add_list '("A4" "A3" "A2" "A1" "A0"))
(end_list)
(start_list "plotstyle")
(mapcar 'add_list '("current" "monochrome.ctb" "acad.ctb"))
(end_list)
(set_tile "paper" (itoa *bpp:ui-paper*))
(set_tile "plotstyle" (itoa *bpp:ui-style*))
(set_tile *bpp:ui-mode* "1")
(set_tile "pdfname" *bpp:ui-name*)
(set_tile "outdir" *bpp:ui-dir*)
(princ "\nBPP_STEP_6_TILES_OK")
(unload_dialog bpp_test_id)
(princ "\nBPP_SMOKE_OK")
._QUIT
_N
